{
  "name": "trapla",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "data": "uv run --with numpy --with tifffile --with pyproj --with pillow --with shapely python pipeline/build_d11.py",
    "shots": "node scripts/screenshots.mjs",
    "smoke": "node scripts/smoke.mjs",
    "bench": "tsx scripts/bench.ts"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "playwright-core": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
