# Cloudflare Pages / Netlify response headers (copied to the site's root by `npm run build`; docs/deploy.md).
# Paths are relative to where the site is deployed. Content-hashed files never change: cache them for a year;
# the pages themselves are always revalidated, so a new deploy is seen at once.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/scenarios/*
  Cache-Control: public, max-age=31536000, immutable
/*.gz
  Content-Type: application/octet-stream
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/about.html
  Cache-Control: no-cache
